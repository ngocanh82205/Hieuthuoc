" as="sourcePoint"/><mxPoint x="884.0" y="198.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="4. Trả danh sách đơn" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="884.0" y="234.0" as="sourcePoint"/><mxPoint x="636.0" y="234.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e19" value="5. Trả dữ liệu đơn hàng" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="624.0" y="270.0" as="sourcePoint"/><mxPoint x="376.0" y="270.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="6. Hiển thị danh sách đơn" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="364.0" y="306.0" as="sourcePoint"/><mxPoint x="116.0" y="306.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e21" value="7. Xác nhận / soạn hàng / giao hàng" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="116.0" y="342.0" as="sourcePoint"/><mxPoint x="364.0" y="342.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e22" value="8. Gửi yêu cầu cập nhật đơn" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="376.0" y="378.0" as="sourc