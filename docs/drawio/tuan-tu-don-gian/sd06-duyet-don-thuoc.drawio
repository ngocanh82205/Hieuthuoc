i đơn thuốc]" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="46.0" y="683.0" width="154.3" height="20.0" as="geometry"/></mxCell><mxCell id="e13" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40.0" y="856.0" as="sourcePoint"/><mxPoint x="944.4" y="856.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="[Thiếu thông tin / đơn hết hiệu lực]" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontSize=12;fontStyle=2;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="46.0" y="857.0" width="272.6" height="20.0" as="geometry"/></mxCell><mxCell id="e15" value="1. Chọn chức năng duyệt đơn thuốc" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="116.0" y="126.0" as="sourcePoint"/><mxPoint x="358.8" y="126.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e16" value="2. Gửi yêu cầu lấy đơn chờ duyệt" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.8" y="162.0" as="sourcePoint"/><mxPoint x="613.6" y="162.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e17" value="3. Truy vấn đơn thuốc chờ duyệt" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.6" y="198.0" as="sourcePoint"/><mxPoint x="868.4" y="198.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e18" value="4. Trả danh sách đơn thuốc" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="868.4" y="234.0" as="sourcePoint"/><mxPoint x="625.6" y="234.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e19" value="5. Trả đơn thuốc và cảnh báo&lt;br&gt;dị ứng, tương tác" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="613.6" y="284.0" as="sourcePoint"/><mxPoint x="370.8" y="284.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="6. Hiển thị đơn thuốc" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="358.8" y="320.0" as="sourcePoint"/><mxPoint x="116.0" y="320.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e21" value="7. Kiểm tra, nhập thông tin,&lt;br&gt;chọn duyệt / từ chối" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="116.0" y="370.0" as="sourcePoint"/><mxPoint x="358.8" y="370.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e22" value="8. Gửi yêu cầu xử lý" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.8" y="406.0" as="sourcePoint"/><mxPoint x="613.6" y="406.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e23" value="9. Kiểm tra CCHN, đủ mục kiểm tra,&lt;br&gt;đơn còn hiệu lực" style="html=1;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;align=left;spacingLeft=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.6" y="456.0" as="sourcePoint"/><mxPoint x="625.6" y="476.0" as="targetPoint"/><Array as="points"><mxPoint x="659.6" y="456.0"/><mxPoint x="659.6" y="476.0"/></Array></mxGeometry></mxCell><mxCell id="e24" value="10. Ghi sổ thuốc kê đơn,&lt;br&gt;cập nhật &quot;Chờ xác nhận&quot;" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.6" y="564.0" as="sourcePoint"/><mxPoint x="868.4" y="564.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e25" value="11. Xác nhận cập nhật" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="868.4" y="600.0" as="sourcePoint"/><mxPoint x="625.6" y="600.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e26" value="12. Thông báo duyệt thành công" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="613.6" y="636.0" as="sourcePoint"/><mxPoint x="370.8" y="636.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e27" value="13. Hiển thị thành công" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="358.8" y="672.0" as="sourcePoint"/><mxPoint x="116.0" y="672.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e28" value="14. Cập nhật &quot;Từ chối&quot;, lưu lý do" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="625.6" y="738.0" as="sourcePoint"/><mxPoint x="868.4" y="738.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e29" value="15. Xác nhận cập nhật" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="868.4" y="774.0" as="sourcePoint"/><mxPoint x="625.6" y="774.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e30" value="16. Thông báo đã từ chối" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="613.6" y="810.0" as="sourcePoint"/><mxPoint x="370.8" y="810.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e31" value="17. Hiển thị kết quả" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="358.8" y="846.0" as="sourcePoint"/><mxPoint x="116.0" y="846.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e32" value="18. Trả thông báo lỗi" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="613.6" y="912.0" as="sourcePoint"/><mxPoint x="370.8" y="912.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e33" value="19. Hiển thị lỗi" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="358.8" y="948.0" as="sourcePoint"/><mxPoint x="116.0" y="948.0" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
