u duyệt" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330.8" y="406.0" as="sourcePoint"/><mxPoint x="573.6" y="406.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e17" value="9. Kiểm tra CCHN, đủ mục kiểm tra,&lt;br&gt;đơn còn hiệu lực" style="html=1;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;align=left;spacingLeft=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585.6" y="456.0" as="sourcePoint"/><mxPoint x="585.6" y="476.0" as="targetPoint"/><Array as="points"><mxPoint x="619.6" y="456.0"/><mxPoint x="619.6" y="476.0"/></Array></mxGeometry></mxCell><mxCell id="e18" value="10. Ghi sổ thuốc kê đơn,&lt;br&gt;cập nhật trạng thái đơn" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585.6" y="528.0" as="sourcePoint"/><mxPoint x="828.4" y="528.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e19" value="11. Xác nhận cập nhật" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828.4" y="564.0" as="sourcePoint"/><mxPoint x="585.6" y="564.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="12. Thông báo duyệt thành công" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="ge