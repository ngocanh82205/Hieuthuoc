ry></mxCell><mxCell id="e18" value="4. Gửi thông tin đăng nhập" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="376.0" y="234.0" as="sourcePoint"/><mxPoint x="624.0" y="234.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e19" value="5. Truy vấn tài khoản" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="636.0" y="270.0" as="sourcePoint"/><mxPoint x="884.0" y="270.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e20" value="6. Trả thông tin tài khoản" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="884.0" y="306.0" as="sourcePoint"/><mxPoint x="636.0" y="306.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e21" value="7. Kiểm tra mật khẩu,&lt;br&gt;trạng thái tài khoản" style="html=1;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;align=left;spacingLeft=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="636.0" y="356.0" as="sourcePoint"/><mxPoint x="636.0" y="376.0" as="targetPoint"/><Array as="points"><mxPoint x="670.0" y="356.0"/><mxPoint x="670.0" y="376.0"/></Array></mxGeometry></mxCell><mxCell id="e22" value="8. Trả kết quả đăng nhập thành công" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;endSize=8;" edge="1" parent="1"><mxGeometry