<mxCell id="e24" value="10. Gửi yêu cầu trình duyệt" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="636.0" y="500.0" as="sourcePoint"/><mxPoint x="884.0" y="500.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e25" value="11. Cập nhật &quot;Chờ duyệt&quot;" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="896.0" y="536.0" as="sourcePoint"/><mxPoint x="1144.0" y="536.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e26" value="12. Mở bảng lương, chọn duyệt / trả lại" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="376.0" y="572.0" as="sourcePoint"/><mxPoint x="624.0" y="572.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e27" value="13. Gửi yêu cầu xử lý" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="636.0" y="608.0" as="sourcePoint"/><mxPoint x="884.0" y="608.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e28" value="14. Cập nhật &quot;Đã duyệt&quot;, tạo phiếu lương" style="html=1;verticalAlign=bottom;fontFamily=Times New Roman;fontSize=13;fontSize=12;strokeColor=#000000;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="896.0" y="680.0" as="sourcePoint"/><mxPoint x="1144.0" y="680.0" as