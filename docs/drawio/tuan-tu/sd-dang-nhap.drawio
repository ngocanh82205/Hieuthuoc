<mxfile host="app.diagrams.net"><diagram id="Tuần tự - Đăng nhập" name="Tuần tự - Đăng nhập"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1524" pageHeight="890" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e1" value="&lt;b&gt;1&lt;/b&gt; Nhập email / SĐT và mật khẩu, bấm &quot;Đăng nhập&quot;" style="html=1;verticalAlign=bottom;align=center;fontFamily=Helvetica;fontSize=12;fontSize=11;strokeColor=#1f4e79;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60.0" y="168.0" as="sourcePoint"/><mxPoint x="383.1" y="168.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="&lt;b&gt;2&lt;/b&gt; POST /api/v1/auth/login&lt;br&gt;{username, password}" style="html=1;verticalAlign=bottom;align=center;fontFamily=Helvetica;fontSize=12;fontSize=11;strokeColor=#1f4e79;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="383.1" y="210.0" as="sourcePoint"/><mxPoint x="697.9" y="210.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="&lt;b&gt;3&lt;/b&gt; authenticate(username, password)" style="html=1;verticalAlign=bottom;align=center;fontFamily=Helvetica;fontSize=12;fontSize=11;strokeColor=#1f4e79;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="697.9" y="238.0" as="sourcePoint"/><mxPoint x="938.1" y="238.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="&lt;b&gt;4&lt;/b&gt; Tìm người dùng theo email hoặc SĐT" style="html=1;verticalAlign=bottom;align=center;fontFamily=Helvetica;fontSize=12;fontSize=11;strokeColor=#1f4e79;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="938.1" y="266.0" as="sourcePoint"/><mxPo