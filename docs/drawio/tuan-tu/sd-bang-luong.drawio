<mxfile host="app.diagrams.net"><diagram id="Tuần tự - Bảng lương" name="Tuần tự - Bảng lương"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1844" pageHeight="1044" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e1" value="&lt;b&gt;1&lt;/b&gt; Chọn tháng, bấm &quot;Tính lương&quot;" style="html=1;verticalAlign=bottom;align=center;fontFamily=Helvetica;fontSize=12;fontSize=11;strokeColor=#1f4e79;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="75.2" y="168.0" as="sourcePoint"/><mxPoint x="514.0" y="168.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e2" value="&lt;b&gt;2&lt;/b&gt; POST /staff/payroll/generate {month}" style="html=1;verticalAlign=bottom;align=center;fontFamily=Helvetica;fontSize=12;fontSize=11;strokeColor=#1f4e79;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="514.0" y="196.0" as="sourcePoint"/><mxPoint x="779.6" y="196.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="&lt;b&gt;3&lt;/b&gt; generate(tháng, người lập)" style="html=1;verticalAlign=bottom;align=center;fontFamily=Helvetica;fontSize=12;fontSize=11;strokeColor=#1f4e79;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="779.6" y="224.0" as="sourcePoint"/><mxPoint x="1161.4" y="224.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e4" value="&lt;b&gt;4&lt;/b&gt; Đọc nhân viên, mức lương, phân ca và chấm công của tháng" style="html=1;verticalAlign=bottom;align=center;fontFamily=Helvetica;fontSize=12;fontSize=11;strokeColor=#1f4e79;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1161.4" y="252.0" as="sourcePoint"/><mxPoint x="1664.5